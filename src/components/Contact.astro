---
import { profile } from "../data/profile";
---

<section id="contact" class="section" aria-labelledby="contact-title">
  <p class="section__label" id="contact-title">Contact</p>

  <div class="contact__grid">
    <div class="contact__main">
      <h2 class="contact__heading">Let’s talk about your sync problem.</h2>
      <p class="contact__sub">
        Best way is email — I read everything, reply within 48h. If it’s a
        good fit I’ll send a Cal link and a one-page scoping note. No recruiters
        for full-time roles, please.
      </p>

      <div class="contact__email">
        <a class="contact__email-link" href={`mailto:${profile.email}`}>{profile.email}</a>
        <button
          type="button"
          class="contact__copy mono"
          data-copy={profile.email}
          aria-label="Copy email to clipboard"
        >
          Copy
        </button>
      </div>
      <p class="contact__hint mono" id="copy-hint" aria-live="polite"></p>

      <div class="contact__links mono">
        {
          profile.socials.map((s) => (
            <a href={s.href} rel="me" target="_blank">
              {s.label} <span aria-hidden="true">↗</span> <span class="sr-only">({s.handle})</span>
            </a>
          ))
        }
      </div>
    </div>

    <form
      class="contact__form"
      aria-label="Contact form (demo — no backend)"
      onsubmit="return false"
    >
      <label class="field">
        <span class="field__label mono">Your email</span>
        <input type="email" name="email" placeholder="you@team.co" required autocomplete="email" />
      </label>
      <label class="field">
        <span class="field__label mono">What are you building?</span>
        <textarea name="message" rows="4" placeholder="A collaborative editor that… / We’re hitting fanout limits at…"></textarea>
      </label>
      <button type="submit" class="field__submit mono">Send — I’ll reply within 48h</button>
      <p class="field__note mono">Form is a placeholder — it shows an inline confirmation. Email is the real channel.</p>
    </form>
  </div>
</section>

<style>
  .contact__grid {
    display: grid;
    gap: var(--space-xl);
  }

  @media (min-width: 56rem) {
    .contact__grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: var(--space-2xl);
      align-items: start;
    }
  }

  .contact__heading {
    font-size: var(--step-2);
    line-height: var(--leading-snug);
    max-width: 22ch;
  }

  .contact__sub {
    margin-top: var(--space-xs);
    color: var(--color-ink-soft);
    line-height: var(--leading-loose);
    max-width: 34rem;
  }

  .contact__email {
    margin-top: var(--space-m);
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    flex-wrap: wrap;
  }

  .contact__email-link {
    font-family: var(--font-mono),serif;
    font-size: var(--step-0);
    font-weight: 500;
    text-decoration: none;
    border-bottom: 2px solid var(--color-accent);
    padding-bottom: 2px;
  }

  .contact__copy {
    font-size: var(--step--1);
    padding: 0.4em 0.75em;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    border-radius: var(--radius-xs);
    cursor: pointer;
    color: var(--color-fg);
  }

  .contact__copy:hover {
    border-color: var(--color-ink);
  }

  .contact__hint {
    min-height: 1.2em;
    margin-top: var(--space-2xs);
    color: var(--color-accent-2);
    font-size: var(--step--2);
  }

  .contact__links {
    margin-top: var(--space-s);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    font-size: var(--step--1);
  }

  .contact__links a {
    text-decoration: none;
    color: var(--color-muted);
    border-bottom: 1px solid var(--color-border);
  }

  .contact__links a:hover {
    color: var(--color-fg);
    border-bottom-color: var(--color-accent);
  }

  .contact__form {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-m);
    padding: var(--space-m);
    background: var(--color-surface-2);
    display: grid;
    gap: var(--space-s);
  }

  .field {
    display: grid;
    gap: var(--space-3xs);
  }

  .field__label {
    font-size: var(--step--2);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .field input,
  .field textarea {
    width: 100%;
    padding: 0.65em 0.8em;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-s);
    background: var(--color-surface);
    color: var(--color-fg);
    font: inherit;
    font-size: var(--step--1);
  }

  .field input:focus,
  .field textarea:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: -1px;
    border-color: transparent;
  }

  .field textarea {
    resize: vertical;
    min-height: 96px;
  }

  .field__submit {
    padding: 0.75em 1em;
    background: var(--color-ink);
    color: var(--color-surface);
    border: 1px solid var(--color-ink);
    border-radius: var(--radius-s);
    cursor: pointer;
    font-weight: 500;
    font-size: var(--step--1);
  }

  .field__submit:hover {
    background: var(--color-ink-soft);
  }

  .field__note {
    color: var(--color-muted);
    font-size: var(--step--2);
    line-height: 1.5;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>("[data-copy]");
  const hint = document.getElementById("copy-hint");
  const form = document.querySelector<HTMLFormElement>(".contact__form");
  const submit = form?.querySelector<HTMLButtonElement>(".field__submit");

  btn?.addEventListener("click", async () => {
    const email = btn.getAttribute("data-copy");
    if (!email) return;
    try {
      await navigator.clipboard.writeText(email);
      if (hint) hint.textContent = "Copied — " + email;
      btn.textContent = "Copied ✓";
      setTimeout(() => {
        if (hint) hint.textContent = "";
        btn.textContent = "Copy";
      }, 2200);
    } catch {
      // fallback: select via mailto
      window.location.href = "mailto:" + email;
    }
  });

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const email = String(data.get("email") || "").trim();
    if (!email) return;
    if (submit) {
      const prev = submit.textContent;
      submit.textContent = "Sent — check your email (demo)";
      submit.disabled = true;
      setTimeout(() => {
        submit.textContent = prev;
        submit.disabled = false;
        form.reset();
      }, 2600);
    }
    if (hint) {
      hint.textContent = "Demo — email " + email + " would be sent. Use " + (btn?.getAttribute("data-copy") || "") + " for real.";
      hint.style.color = "var(--color-muted)";
    }
  });
</script>
