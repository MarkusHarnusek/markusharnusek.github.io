---
import { profile } from "../data/profile";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__main">
    <p class="hero__kicker mono">Software Engineering Student · Upper Austria</p>
    <h1 id="hero-title" class="hero__title">
      Markus<br />
      <em>Harnúšek</em>
    </h1>
    <p class="hero__sub">
Hi, I'm Markus, a 16-year-old Software Engineering student at HTL Leonding, aspiring to build a career in software development. Ever since I started programming at the age of 8, my interest in technology and innovation have been a part of my everyday life.    </p>
    <div class="hero__ctas">
      <a class="btn btn--ghost" href="#projects">See my work</a>
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    gap: var(--space-xl);
    padding-block: var(--space-xl) var(--space-xl);
  }

  .hero__kicker {
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--step--2);
    margin-bottom: var(--space-s);
  }

  .hero__title {
    font-size: clamp(2.4rem, 5vw + 1rem, 4.2rem);
    line-height: 0.95;
    letter-spacing: var(--tracking-display);
  }

  .hero__title em {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    color: var(--color-accent);
  }

  .hero__sub {
    margin-top: var(--space-m);
    max-width: 32rem;
    color: var(--color-ink-soft);
    font-size: var(--step-0);
    line-height: var(--leading-loose);
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-m);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.7em 1.1em;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 500;
    text-decoration: none;
    border-radius: var(--radius-xs);
    border: 1px solid transparent;
    transition:
      background var(--duration-s) var(--ease-out),
      color var(--duration-s) var(--ease-out),
      border-color var(--duration-s) var(--ease-out),
      transform var(--duration-s) var(--ease-out);
  }

  .btn--primary {
    background: var(--color-ink);
    color: var(--color-surface);
    border-color: var(--color-ink);
  }

  .btn--primary:hover {
    background: var(--color-ink-soft);
    color: var(--color-surface);
    transform: translateY(-1px);
  }

  .btn--ghost {
    background: transparent;
    color: var(--color-fg);
    border-color: var(--color-border);
  }

  .btn--ghost:hover {
    border-color: var(--color-ink);
    background: var(--color-surface-2);
  }

  .hero__meta {
    margin-top: var(--space-s);
    color: var(--color-muted);
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    font-size: var(--step--2);
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent-2);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-accent-2) 18%, transparent);
    flex-shrink: 0;
  }

  /* load-in clip wipe — orchestrated moment */
  @media (prefers-reduced-motion: no-preference) {
    .hero__title {
      animation: wipe var(--duration-l) var(--ease-out) both;
    }
    .hero__sub,
    .hero__ctas,
    .hero__meta {
      animation: rise var(--duration-m) var(--ease-out) both;
      animation-delay: 180ms;
    }
  }

  @keyframes wipe {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>


