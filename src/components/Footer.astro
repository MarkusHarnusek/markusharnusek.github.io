---
const year = new Date().getFullYear();
---

<footer class="site-footer mono" aria-label="Footer">
  <div class="site-footer__inner">
    <p>© {year} Silas Varga · Berlin · <a href="mailto:silas@varga.build">silas@varga.build</a></p>
    <p class="site-footer__note">Set in Instrument Serif &amp; IBM Plex. No trackers. No cookies. <a href="#">Imprint</a> · <a href="#">RSS</a></p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-2xl);
    padding-block: var(--space-m);
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
    font-size: var(--step--2);
    line-height: 1.6;
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-m);
  }

  .site-footer a {
    color: var(--color-muted);
  }

  .site-footer a:hover {
    color: var(--color-fg);
  }

  .site-footer__note {
    opacity: 0.9;
  }
</style>
