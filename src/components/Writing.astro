---
import { posts } from "../data/writing";
---

<section id="writing" class="section" aria-labelledby="writing-title">
  <p class="section__label" id="writing-title">Writing</p>
  <p class="writing__intro">
    Notes from the work — not a content strategy, just things I wish I’d read
    before the incident.
  </p>

  <div class="posts">
    {
      posts.map((post) => (
        <article class="post">
          <a class="post__link" href={`#${post.slug}`}>
            <time class="post__date mono" datetime={post.date}>
              {new Date(post.date).toLocaleDateString("en-GB", {
                year: "numeric",
                month: "short",
                day: "2-digit",
              })}
            </time>
            <h3 class="post__title">{post.title}</h3>
            <p class="post__excerpt">{post.excerpt}</p>
          </a>
        </article>
      ))
    }
  </div>
  <p class="writing__more mono">
    <a href="#">All notes → RSS</a>
  </p>
</section>

<style>
  .writing__intro {
    max-width: 36rem;
    color: var(--color-muted);
    font-size: var(--step--1);
    margin-bottom: var(--space-m);
  }

  .posts {
    display: grid;
    gap: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-m);
    overflow: hidden;
    background: var(--color-surface);
  }

  .post + .post {
    border-top: 1px solid var(--color-border);
  }

  .post__link {
    display: grid;
    gap: var(--space-3xs);
    padding: var(--space-s) var(--space-m);
    text-decoration: none;
    color: inherit;
    transition: background var(--duration-s) var(--ease-out);
  }

  .post__link:hover {
    background: var(--color-surface-2);
  }

  .post__date {
    color: var(--color-muted);
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .post__title {
    font-family: var(--font-body);
    font-size: var(--step-0);
    font-weight: 600;
    line-height: var(--leading-snug);
    letter-spacing: -0.01em;
  }

  .post__excerpt {
    color: var(--color-muted);
    font-size: var(--step--1);
    line-height: var(--leading-normal);
  }

  .writing__more {
    margin-top: var(--space-s);
    font-size: var(--step--1);
  }

  .writing__more a {
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
  }

  .writing__more a:hover {
    border-bottom-color: var(--color-accent);
  }
</style>
