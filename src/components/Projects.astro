---
import { projects } from "../data/projects";
import mdDoc from "../../img/md-doc.webp";
const featured = projects.find((p) => p.featured)!;
const rest = projects.filter((p) => !p.featured);

// highlights are stored as one " · "-separated string; render them as a list
const points = (h?: string) => (h ? h.split(" · ").map((s) => s.trim()).filter(Boolean) : []);
---

<section id="projects" class="section" aria-labelledby="projects-title">
  <div class="projects__head">
    <h2 class="section__label" id="projects-title" data-reveal>Projects</h2>
    <p class="projects__intro" data-reveal>
      A selection of my smaller projects: embedded, web tools and C# desktop utilities.
    </p>
  </div>

  <!-- featured -->
  <article class="project project--featured" aria-labelledby={`proj-${featured.slug}`}>
    <div class="project__media" data-reveal>
      <div class="project__frame">
        <img src={mdDoc.src} alt="Screenshot of the MarkDown Doc documentation site" width={mdDoc.width} height={mdDoc.height} loading="lazy" decoding="async" />
      </div>
    </div>
    <div class="project__body" data-reveal>
      <p class="project__meta mono">
        <span>{featured.year}</span>
        <span class="project__line" aria-hidden="true"></span>
        <span>Open source</span>
      </p>
      <h3 id={`proj-${featured.slug}`} class="project__title bold">{featured.name}</h3>
      <p class="project__problem">{featured.problem}</p>
      <p class="project__role mono">{featured.role}</p>
      {
        featured.highlight && (
          <ul class="project__points">
            {points(featured.highlight).map((h) => <li>{h}</li>)}
          </ul>
        )
      }
      <ul class="stack" role="list">
        {featured.stack.map((s) => <li class="stack__pill mono">{s}</li>)}
      </ul>
      <div class="project__links">
        {featured.links?.repo && <a href={featured.links.repo} target="_blank">Repo</a>}
        {featured.links?.demo && <a href={featured.links.demo} target="_blank">Demo</a>}
        {featured.links?.usage && <a href={featured.links.usage} target="_blank">See it in use</a>}
      </div>
    </div>
  </article>

  <div class="projects__rest">
    {
      rest.map((p, i) => (
        <article
          class:list={["project", "project--compact", { "project--pick": i === 1 }]}
          aria-labelledby={`proj-${p.slug}`}
          data-reveal
        >
          <p class="project__meta mono">
            <span>{p.year}</span>
            <span class="project__line" aria-hidden="true" />
            <span>{p.stack[0]}</span>
          </p>
          <h3 id={`proj-${p.slug}`} class="project__title project__title--sm">
            {p.name}
          </h3>
          <p class="project__problem project__problem--sm">{p.problem}</p>
          <p class="project__role mono">{p.role}</p>
          {p.highlight && (
            <ul class="project__points project__points--sm">
              {points(p.highlight).map((h) => (
                <li>{h}</li>
              ))}
            </ul>
          )}
          <ul class="stack stack--sm" role="list">
            {p.stack.map((s) => (
              <li class="stack__pill mono">{s}</li>
            ))}
          </ul>
          {(p.links?.repo || p.links?.demo || p.links?.usage) && (
            <div class="project__links project__links--sm">
              {p.links.repo && <a href={p.links.repo} target="_blank">Repo</a>}
              {p.links.demo && <a href={p.links.demo} target="_blank">Demo</a>}
              {p.links.usage && <a href={p.links.usage} target="_blank">See it in use</a>}
            </div>
          )}
        </article>
      ))
    }
  </div>
</section>

<style>
  .projects__head {
    margin-bottom: var(--space-l);
  }

  .projects__intro {
    max-width: 36rem;
    color: var(--color-muted);
    font-size: var(--step--1);
    line-height: var(--leading-loose);
  }

  /* — featured: open layout, framed screenshot like the GoalFinder photo — */
  .project--featured {
    display: grid;
    gap: var(--space-l);
  }

  @media (min-width: 56rem) {
    .project--featured {
      grid-template-columns: 1.05fr 1fr;
      gap: var(--space-xl);
    }
  }

  .project__media {
    position: relative;
    aspect-ratio: 1;
  }

  @media (min-width: 56rem) {
    .project__media {
      aspect-ratio: auto;
      min-height: 100%;
    }
  }

  .project__frame {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-m);
    background: var(--color-surface-2);
  }

  .project__frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bold {
    font-weight: bold;
  }

  /* — shared text — */
  .project__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    color: var(--color-muted);
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .project__line {
    flex: 1;
    height: 1px;
    background: var(--color-border);
    transform-origin: left;
  }

  .project__title {
    margin-top: var(--space-xs);
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-display);
  }

  .project__title--sm {
    margin-top: var(--space-2xs);
    font-size: var(--step-1);
    font-family: var(--font-body);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .project__problem {
    margin-top: var(--space-2xs);
    color: var(--color-ink-soft);
    line-height: var(--leading-normal);
    font-size: var(--step-0);
  }

  .project__problem--sm {
    font-size: var(--step--1);
    color: var(--color-muted);
  }

  .project__role {
    margin-top: var(--space-xs);
    color: var(--color-muted);
    font-size: var(--step--2);
  }

  /* highlights: plain list, same treatment as Experience / GoalFinder bullets */
  .project__points {
    margin-top: var(--space-s);
    padding-left: 1.1em;
    display: grid;
    gap: var(--space-3xs);
    color: var(--color-ink-soft);
    font-size: var(--step--1);
    line-height: var(--leading-normal);
  }

  .project__points li::marker {
    color: var(--color-muted);
  }

  .project__points--sm {
    margin-top: var(--space-xs);
    font-size: var(--step--2);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
    list-style: none;
    padding: 0;
    margin-top: var(--space-s);
  }

  .stack--sm {
    margin-top: var(--space-xs);
  }

  .stack__pill {
    padding: 0.28em 0.55em;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface-2);
    font-size: var(--step--2);
    color: var(--color-ink-soft);
  }

  .project__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin-top: var(--space-m);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .project__links--sm {
    margin-top: auto;
    padding-top: var(--space-s);
    font-size: var(--step--2);
  }

  .project__links a {
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 1px;
    transition: border-color var(--duration-s) var(--ease-out);
  }

  .project__links a:hover,
  .project__links a:focus-visible {
    border-bottom-color: var(--color-accent);
  }

  /*
   * — smaller projects —
   * Stacked on narrow screens with a rule above each one; three columns
   * on wider screens, split by vertical lines. Every column keeps its top
   * rule so the row reads like a table head; the picked project's rule
   * is accent blue and thicker (it used to be the blue-edged card).
   */
  .projects__rest {
    display: grid;
    margin-top: var(--space-xl);
  }

  .project--compact {
    position: relative;
    display: flex;
    flex-direction: column;
    padding-block: var(--space-m);
  }

  /* top rule */
  .project--compact::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--color-border);
    transform-origin: left;
  }

  .project--pick::after {
    height: 2px;
    background: var(--color-accent);
  }

  .project--pick .project__meta span:first-child {
    color: var(--color-accent);
  }

  @media (min-width: 48rem) {
    .projects__rest {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .project--compact {
      padding: var(--space-m) var(--space-m) 0;
    }

    .project--compact:nth-child(3n + 1) {
      padding-left: 0;
    }

    .project--compact:nth-child(3n) {
      padding-right: 0;
    }

    /* second row onward gets breathing room above its rule */
    .project--compact:nth-child(n + 4) {
      margin-top: var(--space-l);
    }

    /* vertical divider between columns */
    .project--compact:not(:nth-child(3n + 1))::before {
      content: "";
      position: absolute;
      top: 0;
      bottom: 0;
      left: 0;
      width: 1px;
      background: var(--color-border);
      transform-origin: top;
    }
  }

  /*
   * Motion. Blocks use the shared [data-reveal] fade/slide (motion.css).
   * On top of that: the screenshot wipes open top-down and settles from a
   * slight zoom; each compact project draws its top rule left → right,
   * then its column divider top → bottom, so the row assembles like a
   * table being ruled. Everything waits for the element's own stagger
   * slot (--i, set by motion.ts). Exits are immediate and fast.
   */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .project__media,
    :global(.js) .project--compact,
    :global(.js) .project__body {
      --row-delay: calc(min(var(--i, 0), var(--stagger-max)) * var(--stagger));
    }

    /* screenshot wipe */
    :global(.js) .project__frame {
      clip-path: inset(0 0 100% 0 round var(--radius-m));
      transition: clip-path var(--duration-hide) var(--ease-in-out);
    }

    :global(.js) .project__frame img {
      scale: 1.06;
      transition: scale var(--duration-hide) var(--ease-in-out);
    }

    :global(.js) .project__media:global(.is-revealed) .project__frame {
      clip-path: inset(0 0 0 0 round var(--radius-m));
      transition: clip-path 1000ms var(--ease-entrance) var(--row-delay);
    }

    :global(.js) .project__media:global(.is-revealed) .project__frame img {
      scale: 1;
      transition: scale 1400ms var(--ease-entrance) var(--row-delay);
    }

    /* rules + dividers */
    :global(.js) .project--compact::after,
    :global(.js) .project__line {
      scale: 0 1;
      transition: scale var(--duration-hide) var(--ease-in-out);
    }

    :global(.js) .project--compact::before {
      scale: 1 0;
      transition: scale var(--duration-hide) var(--ease-in-out);
    }

    :global(.js) .project--compact:global(.is-revealed)::after {
      scale: 1;
      transition: scale 800ms var(--ease-entrance) var(--row-delay);
    }

    :global(.js) .project--compact:global(.is-revealed)::before {
      scale: 1;
      transition: scale 900ms var(--ease-entrance) calc(var(--row-delay) + 200ms);
    }

    :global(.js) .project__body:global(.is-revealed) .project__line,
    :global(.js) .project--compact:global(.is-revealed) .project__line {
      scale: 1;
      transition: scale 800ms var(--ease-entrance) calc(var(--row-delay) + 150ms);
    }
  }

  @media print {
    .project__frame,
    .project__frame img,
    .project__line,
    .project--compact::before,
    .project--compact::after {
      clip-path: none !important;
      scale: 1 !important;
    }
  }
</style>
