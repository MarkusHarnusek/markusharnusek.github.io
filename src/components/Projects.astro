---
import { projects } from "../data/projects";
import mdDoc from "../../img/md-doc.webp";
const featured = projects.find((p) => p.featured)!;
const rest = projects.filter((p) => !p.featured);
---

<section id="projects" class="section" aria-labelledby="projects-title">
  <div class="projects__head">
    <p class="section__label" id="projects-title">Projects</p>
    <p class="projects__intro">
      A selection of a few of my smaller projects. Mostly some simple Web Dev Projects and C# utilities.
    </p>
  </div>

  <!-- featured -->
  <article class="project project--featured" aria-labelledby={`proj-${featured.slug}`}>
    <div class="project__media" aria-hidden="true">
      <img src={mdDoc.src} alt="image showcasing markdown doc" />
    </div>
    <div class="project__body">
      <div class="project__meta mono">
        <span>{featured.year} · open source</span>
      </div>
      <h1 id={`proj-${featured.slug}`} class="project__title bold">{featured.name}</h1>
      <p class="project__problem">{featured.problem}</p>
      <p class="project__role mono">{featured.role}</p>
      <ul class="stack" role="list">
        {featured.stack.map((s) => <li class="stack__pill mono">{s}</li>)}
      </ul>
      {featured.highlight && <p class="project__highlight mono">{featured.highlight}</p>}
      <div class="project__links">
        {featured.links?.repo && <a href={featured.links.repo} target="_blank">Repo</a>}
        {featured.links?.demo && <a href={featured.links.demo} target="_blank">Demo</a>}
        {featured.links?.usage && <a href={featured.links.usage} target="_blank">Usage</a>}
      </div>
    </div>
  </article>

  <div class="projects__rest">
    {
      rest.map((p) => (
        <article class="project project--compact" aria-labelledby={`proj-${p.slug}`}>
          <div class="project__meta mono">
            <span>{p.year}</span>
            <span class="project__year-line" aria-hidden="true" />
            <span>{p.stack[0]}</span>
          </div>
          <h1 id={`proj-${p.slug}`} class="project__title project__title--sm">
            {p.name}
          </h1>
          <p class="project__problem project__problem--sm">{p.problem}</p>
          <p class="project__role mono">{p.role}</p>
          {p.highlight && <p class="project__highlight project__highlight--sm mono">{p.highlight}</p>}
          <ul class="stack stack--sm" role="list">
            {p.stack.map((s) => (
              <li class="stack__pill mono">{s}</li>
            ))}
          </ul>
          {(p.links?.repo || p.links?.demo || p.links?.usage) && (
            <div class="project__links project__links--sm">
              {p.links.repo && <a href={p.links.repo} target="_blank">Repo</a>}
              {p.links.demo && <a href={p.links.demo} target="_blank">Demo</a>}
              {p.links.usage && <a href={p.links.usage} target="_blank">Usage</a>}
            </div>
          )}
        </article>
      ))
    }
  </div>
</section>

<style>
  .projects__head {
    margin-bottom: var(--space-m);
  }

  .projects__intro {
    max-width: 36rem;
    color: var(--color-muted);
    font-size: var(--step--1);
    line-height: var(--leading-loose);
  }

  .projects__intro code {
    font-family: var(--font-mono),serif;
    font-size: 0.92em;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    padding: 0.08em 0.35em;
    border-radius: var(--radius-xs);
  }

  /* featured */
  .project--featured {
    display: grid;
    gap: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-m);
    overflow: hidden;
    background: var(--color-surface);
  }

  @media (min-width: 56rem) {
    .project--featured {
      grid-template-columns: 1.05fr 1fr;
    }
  }

  .project__media {
    position: relative;
    background: var(--color-ink);
    overflow: hidden;
    min-height: 100%;
    aspect-ratio: 1;
  }

  .project__media img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 56rem) {
    .project__media {
      aspect-ratio: auto;
    }
  }

  .bold {
    font-weight: bold;
  }

  .project__body {
    padding: var(--space-m);
  }

  .project__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    color: var(--color-muted);
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .project__title {
    margin-top: var(--space-2xs);
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-display);
  }

  .project__title--sm {
    font-size: var(--step-1);
    font-family: var(--font-body);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .project__problem {
    margin-top: var(--space-2xs);
    color: var(--color-ink-soft);
    line-height: var(--leading-normal);
    font-size: var(--step-0);
  }

  .project__problem--sm {
    font-size: var(--step--1);
    color: var(--color-muted);
  }

  .project__role {
    margin-top: var(--space-xs);
    color: var(--color-muted);
    font-size: var(--step--2);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
    list-style: none;
    padding: 0;
    margin-top: var(--space-xs);
  }

  .stack--sm {
    margin-top: var(--space-2xs);
  }

  .stack__pill {
    padding: 0.28em 0.55em;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface-2);
    font-size: var(--step--2);
    color: var(--color-ink-soft);
  }

  .project__highlight {
    margin-top: var(--space-xs);
    padding: var(--space-2xs) var(--space-xs);
    border-left: 3px solid var(--color-accent-2);
    background: color-mix(in srgb, var(--color-accent-2) 8%, transparent);
    color: var(--color-ink-soft);
    font-size: var(--step--2);
    line-height: 1.5;
  }

  .project__highlight--sm {
    padding: var(--space-3xs) var(--space-2xs);
    font-size: var(--step--2);
  }

  .project__links {
    display: flex;
    gap: var(--space-s);
    margin-top: var(--space-s);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .project__links--sm {
    margin-top: var(--space-xs);
    font-size: var(--step--2);
  }

  .project__links a {
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 1px;
  }

  .project__links a:hover {
    border-bottom-color: var(--color-accent);
  }

  /* rest grid — auto-fit intrinsic */
  .projects__rest {
    display: grid;
    gap: var(--space-s);
    margin-top: var(--space-s);
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }

  .project--compact {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-m);
    padding: var(--space-s);
    background: var(--color-surface);
    display: flex;
    flex-direction: column;
  }

  .project--compact .project__year-line {
    flex: 1;
    height: 1px;
    background: var(--color-border);
    margin-inline: var(--space-2xs);
  }

  /* small variation: second compact gets teal top edge */
  .project--compact:nth-child(2) {
    border-top-color: var(--color-accent-2);
    border-top-width: 2px;
  }
</style>
